---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없음" description="요청한 주소에 페이지가 없습니다">
  <section class="hero hero-list nf">
    <div class="w hero-in">
      <div class="eyebrow">404 · NOT FOUND</div>
      <h1>No frame<br /><span class="ol">here.</span></h1>
      <p class="hero-sub">주소가 바뀌었거나 지운 작품일 수 있습니다. 아래에서 다시 찾아보세요.</p>
      <div class="nf-links">
        <a class="pill pill--primary" href="/">전체 작품 보기</a>
        <a class="pill" href="/videos">영상</a>
        <a class="pill" href="/images">이미지</a>
      </div>
    </div>
  </section>
  <main class="w" style="padding-bottom:80px"></main>
</Base>
