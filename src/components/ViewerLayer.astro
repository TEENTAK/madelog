---
// 모달 한 겹. 영상 클립·이미지 모두 같은 틀을 쓰고 src/scripts/viewer.ts 가 채운다.
interface Props { id: string }
const { id } = Astro.props;
---
<div class="mv-dim" id={id} data-layer hidden>
  <div class="modal mv-modal" role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} tabindex="-1">
    <div class="viewer">
      <div class="mv-stage">
        <img data-v="img" alt="" decoding="async" draggable="false" hidden />
        <video data-v="video" controls controlslist="nodownload noremoteplayback" disablepictureinpicture disableremoteplayback playsinline preload="metadata" hidden></video>
      </div>
      <button type="button" class="arr mv-arr--l" data-v="prev" aria-label="이전"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
      <button type="button" class="arr mv-arr--r" data-v="next" aria-label="다음"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
      <div class="viewer-strip" data-v="strip"></div>
      <div class="viewer-count" data-v="count"></div>
    </div>
    <div class="panel">
      <button type="button" class="close" data-v="close" aria-label="닫기"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      <h2 data-v="title" id={`${id}-title`}></h2>
      <div class="tags mv-tags"><span class="tag tag--type" data-v="kind"></span><span class="tag tag--model" data-v="label"></span></div>
      <div data-v="refs-wrap" hidden>
        <div class="lab mv-lab">REFERENCES</div>
        <div class="refs" data-v="refs"></div>
      </div>
      <div data-v="prompt-wrap" hidden>
        <div class="lab mv-lab">PROMPT</div>
        <div class="acc" data-v="pf">
          <div class="acc__head">
            <button type="button" class="acc__toggle" data-v="more" aria-expanded="false" aria-controls={`${id}-prompt`}>
              <span>생성 프롬프트</span>
              <svg class="acc__chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
            </button>
            <button type="button" class="chip chip--primary" data-v="copy">복사</button>
          </div>
          <div class="acc__body" id={`${id}-prompt`} data-v="acc-body"><div class="prompt" data-v="prompt"></div></div>
        </div>
      </div>
      <div class="lab mv-lab">DETAILS</div>
      <div class="mv-details" data-v="details"></div>
    </div>
  </div>
</div>
